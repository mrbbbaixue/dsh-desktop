<Window x:Class="DshDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DeepSeek Harness"
        Width="1280" Height="840"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />
        <!-- 服务未就绪时的等待/失败遮罩 -->
        <Border x:Name="StatusOverlay" Background="#FFFFFFFF" Visibility="Collapsed">
            <StackPanel Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar x:Name="StatusProgress" IsIndeterminate="True" Height="6" />
                <TextBlock x:Name="StatusText"
                           Text="正在启动 dsh 服务…"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,16,0,0" Foreground="#FF555555" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
