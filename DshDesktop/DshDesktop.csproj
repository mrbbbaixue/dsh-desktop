<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 11 inbox 是 .NET Framework 4.8(21H2) / 4.8.1(22H2+),没有现代 .NET 运行时。 -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标 (NotifyIcon) 来自 WinForms -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>DshDesktop</AssemblyName>
    <RootNamespace>DshDesktop</RootNamespace>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\favicon.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\favicon.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DshDesktop.Tests" />
  </ItemGroup>

  <!-- publish 会再次拷贝 nuget 原生/托管 DLL,Costura 织入后删掉旁路文件 -->
  <Target Name="StripPublishedDependencies" AfterTargets="Publish">
    <ItemGroup>
      <_PublishExtra Include="$(PublishDir)*.dll" />
      <_PublishExtra Include="$(PublishDir)runtimes\**\*" />
      <_PublishExtra Include="$(PublishDir)*.pdb" />
      <_PublishExtra Include="$(PublishDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(_PublishExtra)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(PublishDir)runtimes" Condition="Exists('$(PublishDir)runtimes')" />
  </Target>

</Project>
