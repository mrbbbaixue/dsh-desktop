<Window x:Class="DshDesktop.Windows.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="诊断窗口"
        Width="600" Height="620"
        MinWidth="540" MinHeight="520"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextFg}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 深浅色:这里的默认值是浅色一套,ApplyTheme() 按系统主题整组替换同名资源,DynamicResource 自动刷新 -->
        <SolidColorBrush x:Key="WindowBg" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextFg" Color="#FF333333" />
        <SolidColorBrush x:Key="MutedFg" Color="#FF777777" />
        <SolidColorBrush x:Key="PanelBorder" Color="#FFDDDDDD" />
        <SolidColorBrush x:Key="InputBg" Color="#FFF7F7F7" />
        <SolidColorBrush x:Key="HoverBg" Color="#FFE9E9E9" />
        <SolidColorBrush x:Key="ErrorFg" Color="#FFC62828" />
        <SolidColorBrush x:Key="AccentFg" Color="#FF2EA043" />

        <!-- 平铺按钮:Aero 默认模板不吃 Background,深色主题下会是一块浅色岛 -->
        <ControlTemplate x:Key="FlatButton" TargetType="Button">
            <Grid>
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" />
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatButton}" />
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFg}" />
        </Style>

        <!-- 下拉框同样平铺:PART_Popup 名字要保留,否则点外面关不掉 -->
        <ControlTemplate x:Key="FlatComboBox" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              Foreground="{TemplateBinding Foreground}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="3" />
                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                      Data="M0,0 L8,0 L4,5 Z" Fill="{TemplateBinding Foreground}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Margin="9,3,26,3" VerticalAlignment="Center" IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                       Focusable="False" PopupAnimation="Slide"
                       IsOpen="{TemplateBinding IsDropDownOpen}">
                    <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1" CornerRadius="3" Margin="0,2,0,0">
                        <ScrollViewer CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource FlatComboBox}" />
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFg}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFg}" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 环境诊断 -->
        <Grid Grid.Row="0">
            <TextBlock Text="环境诊断" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="RecheckButton" Content="重新检测" HorizontalAlignment="Right"
                    Padding="10,2" Click="OnRecheckClick" />
        </Grid>

        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10,6" BorderThickness="1" CornerRadius="3"
                BorderBrush="{DynamicResource PanelBorder}">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" MinWidth="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Glyph" Grid.Column="0" Text="✔" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Status" Grid.Column="2" Text="{Binding Status}" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{DynamicResource MutedFg}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                <Setter TargetName="Glyph" Property="Text" Value="✘" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource ErrorFg}" />
                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource ErrorFg}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 一键安装 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="一键安装(装到系统,过程中会弹一次 UAC)"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="安装源" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource MutedFg}" />
                <ComboBox x:Name="SourceBox" Width="190" SelectedIndex="0">
                    <ComboBoxItem Content="官方源(winget)" />
                    <ComboBoxItem Content="国内镜像(npmmirror)" />
                </ComboBox>
            </StackPanel>

            <Button x:Name="InstallButton" Grid.Row="1" Grid.Column="0" Content="安装缺失组件"
                    HorizontalAlignment="Left" Margin="0,10,0,0" Padding="16,5" Click="OnInstallClick" />
            <TextBlock x:Name="InstallHint" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                       Margin="0,10,0,0" Foreground="{DynamicResource MutedFg}" />
        </Grid>

        <!-- 进度与日志 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 空闲时整条收起,只有安装中/完成/失败才出现 -->
            <ProgressBar x:Name="InstallBar" Height="6" Visibility="Collapsed" Grid.Row="0"
                         Background="{DynamicResource InputBg}" Foreground="{DynamicResource AccentFg}" />
            <TextBlock x:Name="ProgressText" Grid.Row="1" Margin="0,8,0,6" TextWrapping="Wrap"
                       Text="就绪" Foreground="{DynamicResource MutedFg}" />
            <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" BorderThickness="1" Padding="6"
                     Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextFg}"
                     BorderBrush="{DynamicResource PanelBorder}" />
        </Grid>
    </Grid>
</Window>
